      <div class="member-card">
        <img src="#" alt="Trésorière"/>
        <h3>Florianne</h3>
        <p>Charger de communication</p>
        <p>Licence 1 en Reseaux Telecomunication</p>
        <div class="member-social">
          <a href="#"><i class="fab fa-facebook"></i></a>
          <a href="#"><i class="fab fa-twitter"></i></a>
          <a href="#"><i class="fab fa-linkedin"></i></a>
        </div>
      </div>
    </div>
  </section>

  <section id="events">
    <h2>Nos Événements</h2>
    <div class="event-grid">
      <div class="event-card">
        <div class="event-date">
          <span class="day">23</span>
          <span class="month">Mai</span>
        </div>
        <h3>Journée Culturelle Congolaise</h3>
        <p>Une journée dédiée à la célébration de la culture congolaise avec danse, musique et cuisine traditionnelle.</p>
        <div class="event-location">
          <i class="fas fa-map-marker-alt"></i>
          <span>Magique Land</span>
        </div>
      </div>
      <div class="event-card">
        <div class="event-date">
          <span class="day">15</span>
          <span class="month">Aout</span>
        </div>
        <h3>Fête de l'independance</h3>
        <p>Une journée de festivités et de plaisir pour tous les membres de la communauté.</p>
        <div class="event-location">
          <i class="fas fa-map-marker-alt"></i>
          <span>Salle AS21, ISI Dakar</span>
        </div>
